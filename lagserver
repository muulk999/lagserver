-- ABA 3: SPAM DE MANSÃO ("TIRA E BOTA") BASEADO NOS LOGS
local Tab3 = Window:CreateTab("Spam de Mansão", 4483362458)
local Sec3 = Tab3:CreateSection("Controle de Spam (Tira e Bota da Mansão ID: 5539258039)")

local mansionSpamActive = false
local mansionID = "5539258039"

local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
        Rayfield:Notify({ Title = "Copiado!", Content = "Código copiado para a área de transferência.", Duration = 2 })
    end
end

Tab3:CreateButton({
   Name = "🌸 Iniciar Spam de Mansão (Tira e Bota Rápido)",
   Callback = function()
       if mansionSpamActive then
           Rayfield:Notify({ Title = "Aviso", Content = "O spam de mansão já está ativo!", Duration = 3 })
           return
       end

       mansionSpamActive = true
       Rayfield:Notify({ Title = "Spam Iniciado", Content = "Alternando entre remover e criar a mansão ID: " .. mansionID, Duration = 4 })

       task.spawn(function()
           local Workspace = game:GetService("Workspace")
           local ReplicatedStorage = game:GetService("ReplicatedStorage")

           while mansionSpamActive do
               -- 1. TIRA (Remove a mansão do Workspace se existir)
               pcall(function()
                   for _, obj in ipairs(Workspace:GetChildren()) do
                       if obj.Name == "UserHouse." .. mansionID or obj.Name:find(mansionID) then
                           obj:Destroy()
                       end
                   end
               end)
               
               task.wait(0.2)
               if not mansionSpamActive then break end

               -- 2. BOTA (Dispara os remotes de construção e recria a pasta)
               pcall(function()
                   for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                       if remote:IsA("RemoteEvent") then
                           local nameL = remote.Name:lower()
                           if nameL:find("house") or nameL:find("mansion") or nameL:find("plot") or nameL:find("buy") then
                               remote:FireServer(mansionID, true)
                               break
                           end
                       end
                   end
                   
                   local fakeHouse = Instance.new("Folder")
                   fakeHouse.Name = "UserHouse." .. mansionID
                   fakeHouse.Parent = Workspace
                   task.wait(0.3)
                   fakeHouse:Destroy()
               end)

               task.wait(0.4)
           end
       end)
   end,
})

Tab3:CreateButton({
   Name = "🛑 Parar Spam de Mansão",
   Callback = function()
       mansionSpamActive = false
       Rayfield:Notify({ Title = "Spam Parado", Content = "O ciclo de tira e bota da mansão foi interrompido.", Duration = 3 })
   end,
})

Tab3:CreateButton({
   Name = "📋 Copiar Snippet do Spam de Mansão",
   Callback = function()
       local snippet = string.format([[
local mansionID = "%s"
local Workspace = game:GetService("Workspace")
for _, obj in ipairs(Workspace:GetChildren()) do
    if obj.Name:find(mansionID) then obj:Destroy() end
end
]], mansionID)
       copyToClipboard(snippet)
   end,
})


-- ABA 4: IMMERSIVE ADS & FORÇAR CLIQUE NO TELÃO
local Tab4 = Window:CreateTab("Immersive Ads", 4483362458)
local Sec4 = Tab4:CreateSection("Forçar Clique no Telão por Jogador")

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local function getPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        table.insert(list, p.Name)
    end
    if #list == 0 then
        table.insert(list, "Nenhum player encontrado")
    end
    return list
end

local selectedTargetPlayer = localPlayer.Name

local PlayerDropdown = Tab4:CreateDropdown({
   Name = "Selecionar Player Alvo",
   Options = getPlayerList(),
   CurrentOption = {localPlayer.Name},
   MultipleOptions = false,
   Flag = "SelectedAdPlayer",
   Callback = function(Option)
       if type(Option) == "table" then
           selectedTargetPlayer = Option[1]
       else
           selectedTargetPlayer = Option
       end
   end,
})

Tab4:CreateButton({
   Name = "🔄 Atualizar Lista de Players",
   Callback = function()
       PlayerDropdown:Refresh(getPlayerList(), true)
       Rayfield:Notify({ Title = "Lista Atualizada", Content = "Jogadores no mapa recarregados.", Duration = 2 })
   end,
})

Tab4:CreateButton({
   Name = "🎯 Forçar Player a Clicar no Telão de Anúncio",
   Callback = function()
       local targetPlr = Players:FindFirstChild(selectedTargetPlayer)
       
       if not targetPlr then
           Rayfield:Notify({ Title = "Erro", Content = "Player selecionado não foi encontrado no servidor!", Duration = 3 })
           return
       end

       Rayfield:Notify({ Title = "Immersive Ads", Content = "Forçando " .. targetPlr.Name .. " a interagir com o telão...", Duration = 3 })
       
       task.spawn(function()
           local workspace = game:GetService("Workspace")
           local replicatedStorage = game:GetService("ReplicatedStorage")
           
           if targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
               local hrp = targetPlr.Character.HumanoidRootPart
               for _, v in ipairs(workspace:GetDescendants()) do
                   local nameL = v.Name:lower()
                   if nameL:find("boardad") or nameL:find("rewardedvideobillboard") or nameL:find("screenframe") or nameL:find("billboard") then
                       pcall(function()
                           if v:IsA("BasePart") then
                               firetouchinterest(hrp, v, 0)
                               firetouchinterest(hrp, v, 1)
                           elseif v:IsA("Model") then
                               local primary = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                               if primary then
                                   firetouchinterest(hrp, primary, 0)
                                   firetouchinterest(hrp, primary, 1)
                               end
                           end
                       end)
                   end
               end
           end

           for _, v in ipairs(workspace:GetDescendants()) do
               if v:IsA("ClickDetector") then
                   local pName = v.Parent.Name:lower()
                   if pName:find("ad") or pName:find("board") or pName:find("reward") then
                       pcall(function()
                           fireclickdetector(v)
                       end)
                   end
               end
           end

           for _, v in ipairs(replicatedStorage:GetDescendants()) do
               if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                   local nameL = v.Name:lower()
                   if nameL:find("ad") or nameL:find("reward") or nameL:find("placement") or nameL:find("billboard") then
                       pcall(function()
                           if v:IsA("RemoteEvent") then
                               v:FireServer(3604972862, "ShowAd", true, targetPlr)
                               v:FireServer("ClickBillboard", targetPlr)
                           end
                       end)
                   end
               end
           end

           Rayfield:Notify({ Title = "Sucesso", Content = "Comando de clique no telão executado para " .. targetPlr.Name, Duration = 3 })
       end)
   end,
})


