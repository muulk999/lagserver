local memoryStressActive = false

Tab1:CreateButton({
   Name = "🔴 Executar Evento: Screen Stop (Memory Stress)",
   Callback = function()
       if memoryStressActive then
           Rayfield:Notify({ Title = "Aviso", Content = "O evento já está rodando!", Duration = 4 })
           return
       end

       memoryStressActive = true

       local ScreenGui = Instance.new("ScreenGui")
       ScreenGui.Name = "ScreenStopAlert"
       ScreenGui.IgnoreGuiInset = true
       ScreenGui.Parent = game:GetService("CoreGui")

       local Frame = Instance.new("Frame")
       Frame.Size = UDim2.new(1, 0, 1, 0)
       Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
       Frame.BackgroundTransparency = 0.3
       Frame.Parent = ScreenGui

       local TextLabel = Instance.new("TextLabel")
       TextLabel.Size = UDim2.new(1, 0, 0, 100)
       TextLabel.Position = UDim2.new(0, 0, 0.45, 0)
       TextLabel.BackgroundTransparency = 1
       TextLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
       TextLabel.TextScaled = true
       TextLabel.Font = Enum.Font.SourceSansBold
       TextLabel.Text = "⚠️ SCREEN STOP ATIVADO: SOBRECARREGANDO RAM ⚠️"
       TextLabel.Parent = Frame

       Rayfield:Notify({ Title = "Evento Iniciado", Content = "Injetando dados para elevar o consumo de RAM...", Duration = 5 })

       task.spawn(function()
           local storageContainer = {}
           for i = 1, 50 do
               if not memoryStressActive then break end
               local heavyFolder = Instance.new("Folder")
               heavyFolder.Name = "StressData_" .. tostring(i)
               
               for j = 1, 500 do
                   local part = Instance.new("Part")
                   part.Size = Vector3.new(10, 10, 10)
                   part.Parent = heavyFolder
               end
               
               table.insert(storageContainer, heavyFolder)
               task.wait(0.1)
           end
           
           task.wait(3)
           ScreenGui:Destroy()
           memoryStressActive = false
           Rayfield:Notify({ Title = "Evento Finalizado", Content = "Ciclo concluído.", Duration = 5 })
       end)
   end,
})

